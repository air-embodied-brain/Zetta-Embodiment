[Unit]
Description=RPent NVIDIA GraspGen ZMQ backend on GPU0
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/zetta/third_party/GraspGen
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/zetta/.venv-graspgen/bin/python client-server/graspgen_server.py --host 127.0.0.1 --port 5558 --gripper_config /opt/zetta/third_party/GraspGenModels/checkpoints/graspgen_franka_panda.yml
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
