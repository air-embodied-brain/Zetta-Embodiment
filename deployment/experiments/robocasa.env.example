# Copy outside the repository, replace every placeholder, and chmod 600.
EXPERIMENT_FAMILY=robocasa
EXPERIMENT_ROOT=/abs/path/to/runs/robocasa-slide-dishwasher-g0000
EXPERIMENT_RUNTIME_ROOT=/node-local/path/to/runtime/robocasa-slide-dishwasher-g0000
EXPERIMENT_QUEUE_ROOT=/shared/path/to/queues/robocasa-slide-dishwasher-g0000
EXPERIMENT_REPO_ROOT=/abs/path/to/Zetta
EXPERIMENT_CAMPAIGN_ID=robocasa-slide-dishwasher-g0000
EXPERIMENT_PYTHON=/abs/path/to/zetta-venv/bin/python
PROVIDER_ENV_FILE=/abs/path/to/providers.env
WORKER_HOST=robocasa-worker-0
MASTER_SEED=20260817

# The control plane, simulator and GR00T may use three independent environments.
ROBOCASA_PYTHON=/abs/path/to/robocasa-venv/bin/python
GROOT_PYTHON=/abs/path/to/groot-venv/bin/python
ROBOCASA_PYTHONPATH=
GROOT_PYTHONPATH=
ROBOCASA_TASK=SlideDishwasherRack
ROBOCASA_SPLIT=target
ROBOCASA_GPUS=0
ROBOCASA_SLOTS=1
ROBOCASA_BASE_PORT=18800
GROOT_GPU=0
GROOT_PORT=18811
GROOT_SOURCE=/abs/path/to/Isaac-GR00T
GROOT_CHECKPOINT=/abs/path/to/checkpoints/GR00T-N1.5-RoboCasa
GROOT_CHECKPOINT_SHA256='replace-with-64-character-checkpoint-digest'

# Formal campaign defaults. Use 1/1 and a small max action count only for a check.
ROLLOUT_COUNT=50
HELDOUT_COUNT=20
INITIAL_LOGICAL_SLOTS=1
MAXIMUM_LOGICAL_SLOTS=1
CONTINUOUS_LOGICAL_SLOTS=1
MAXIMUM_API_CONCURRENCY=8
MAX_INFRASTRUCTURE_ATTEMPTS=8
ROBOCASA_MAX_ACTIONS=1000
ROBOCASA_ACTIONS_PER_CHUNK=16

AGENT_MODEL=gpt-5.6-sol
ROLE1_MODEL=openai:gpt-5.6-sol
REASONING_EFFORT=high
MAX_GENERATIONS=1
WORKER_CONCURRENCY=1
CAMPAIGN_POLL_S=5
CAMPAIGN_MAX_STEPS=0
# Checkpoint hashing and cold shared-storage reads can exceed ten minutes.
SERVICE_START_TIMEOUT_S=900
