# Copy outside the repository, replace every placeholder, and chmod 600.
export PRIMARY_PROVIDER_KEY='<provider-api-key>'
export ZETTA_API_PROVIDER_BROKER_API_KEY='<random-loopback-broker-key>'
export ZETTA_API_PROVIDERS='{
  "cooldown_seconds": 30,
  "providers": [{
    "name": "primary",
    "provider": "openai-responses",
    "base_url": "https://provider.example/v1",
    "api_key_env": "PRIMARY_PROVIDER_KEY",
    "model": "openai-responses:gpt-5.6-sol",
    "price": 1.0,
    "max_concurrency": 8
  }]
}'
export ZETTA_PROVIDER_REQUEST_ADMISSION_ROOT=/node-local/path/to/provider-request-admission
export ZETTA_PROVIDER_ADMISSION_ROOT=/shared/path/to/provider-job-admission
export ZETTA_PROVIDER_INITIAL_CONCURRENCY=8
export ZETTA_PROVIDER_MAX_CONCURRENCY=8
