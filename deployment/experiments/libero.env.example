# Copy outside the repository, replace every placeholder, and chmod 600.
EXPERIMENT_FAMILY=libero
EXPERIMENT_ROOT=/abs/path/to/runs/libero-goal-task3
EXPERIMENT_RUNTIME_ROOT=/node-local/path/to/runtime/libero-goal-task3
EXPERIMENT_QUEUE_ROOT=/shared/path/to/queues/libero-goal-task3
EXPERIMENT_REPO_ROOT=/abs/path/to/Zetta
EXPERIMENT_CAMPAIGN_ID=libero-goal-task3-g0000
EXPERIMENT_PYTHON=/abs/path/to/libero-venv/bin/python
PROVIDER_ENV_FILE=/abs/path/to/providers.env
WORKER_HOST=libero-worker-0
MASTER_SEED=20260817

LIBERO_ASSETS_ROOT=/abs/path/to/libero-assets
LIBERO_SUITE=libero_goal_swap
LIBERO_TASK_ID=3
LIBERO_TASK_LANGUAGE='Open the top layer of the drawer and put the bowl inside'
LIBERO_ENVIRONMENT_GPUS=1
LIBERO_VLA_GPU=0
