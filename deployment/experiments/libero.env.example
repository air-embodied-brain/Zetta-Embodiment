# Formal campaign defaults. Use 1/1 only for a bounded integration check.
ROLLOUT_COUNT=50
HELDOUT_COUNT=20
LIBERO_FIXED_HELDOUT_SEEDS=1-20
HELDOUT_MODE=validation
INITIAL_LOGICAL_SLOTS=1
MAXIMUM_LOGICAL_SLOTS=1
CONTINUOUS_LOGICAL_SLOTS=1
MAXIMUM_API_CONCURRENCY=8
MAX_INFRASTRUCTURE_ATTEMPTS=2
SAME_SEED_PASS_RATE=0.5
SAME_SEED_MAX_ROUNDS=2

AGENT_MODEL=gpt-5.6-sol
ROLE1_MODEL=gpt-5.6-sol
REASONING_EFFORT=high
MAX_GENERATIONS=1
WORKER_CONCURRENCY=1
CAMPAIGN_POLL_S=5
CAMPAIGN_MAX_STEPS=0
SERVICE_START_TIMEOUT_S=300
